                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('has id versions', () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.property('id');",
                  "    pm.expect(b.versions).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]

            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"2.0.0\",\n  \"changelog\": \"New features\",\n  \"runtime\": \"nodejs18\",\n  \"files\": [\n    {\n      \"fileName\": \"index.js\",\n      \"type\": \"SERVER\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('has pluginId versionId uploads', () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.all.keys('pluginId','versionId','uploads');",
                  "});",
                  "const b = pm.response.json();",
                  "if (b.versionId) pm.environment.set('version_id', b.versionId);",
                  "if (b.uploads && b.uploads[0]) pm.environment.set('upload_key', b.uploads[0].key);"
                ]
              }
            }
          ]
        },

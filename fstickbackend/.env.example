# Fstick Backend Environment Configuration
# Copy to .env and modify as needed

# ============ Database Configuration ============
POSTGRES_VERSION=16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Registry Database
REGISTRY_DB_USER=admin
REGISTRY_DB_PASSWORD=1
REGISTRY_DB_NAME=registry_db
REGISTRY_DB_PORT=5434

# Installation Database
INSTALLATION_DB_USER=postgres
INSTALLATION_DB_PASSWORD=postgres
INSTALLATION_DB_NAME=installation_db
INSTALLATION_DB_PORT=5435

# Integration Database
INTEGRATION_DB_USER=postgres
INTEGRATION_DB_PASSWORD=postgres
INTEGRATION_DB_NAME=integration_db
INTEGRATION_DB_PORT=5436

# Runtime Database
RUNTIME_DB_USER=postgres
RUNTIME_DB_PASSWORD=postgres
RUNTIME_DB_NAME=runtime_db
RUNTIME_DB_PORT=5437

# Gateway Database
GATEWAY_DB_USER=postgres
GATEWAY_DB_PASSWORD=postgres
GATEWAY_DB_NAME=gateway_db
GATEWAY_DB_PORT=5438

# ============ Redis Configuration ============
REDIS_VERSION=7-alpine

# Installation Redis
INSTALLATION_REDIS_PORT=6380

# Integration Redis
INTEGRATION_REDIS_PORT=6381

# Runtime Redis
RUNTIME_REDIS_PORT=6382

# ============ MinIO Configuration ============
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=11111111
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_BUCKET=plugins
MINIO_REGION=us-east-1

# ============ Service Configuration ============

# Gateway Service
GATEWAY_SERVICE_PORT=8085
GATEWAY_SERVICE_INTERNAL_PORT=8085

# Registry Service
REGISTRY_SERVICE_PORT=8082
REGISTRY_SERVICE_INTERNAL_PORT=8082

# Installation Service
INSTALLATION_SERVICE_PORT=8083
INSTALLATION_SERVICE_INTERNAL_PORT=8081

# Integration Service
INTEGRATION_SERVICE_PORT=8080
INTEGRATION_SERVICE_INTERNAL_PORT=8080

# Runtime Service
RUNTIME_SERVICE_PORT=8084
RUNTIME_SERVICE_INTERNAL_PORT=8084

# ============ Dendrite Configuration ============
DENDRITE_CLIENT_API_PORT=8008
DENDRITE_FEDERATION_API_PORT=8448

# ============ Service URLs (Internal) ============
# Used for inter-service communication inside Docker network

REGISTRY_SERVICE_URL=http://registry-service:8082
INSTALLATION_SERVICE_URL=http://installation-service:8081
INTEGRATION_SERVICE_URL=http://integration-service:8080
RUNTIME_SERVICE_URL=http://runtime-service:8084
GATEWAY_SERVICE_URL=http://gateway-service:8085
DENDRITE_URL=http://dendrite:8008

# ============ Service URLs (External) ============
# Used for client/host access

REGISTRY_SERVICE_EXTERNAL_URL=http://localhost:8082
INSTALLATION_SERVICE_EXTERNAL_URL=http://localhost:8083
INTEGRATION_SERVICE_EXTERNAL_URL=http://localhost:8080
RUNTIME_SERVICE_EXTERNAL_URL=http://localhost:8084
GATEWAY_SERVICE_EXTERNAL_URL=http://localhost:8085
DENDRITE_EXTERNAL_URL=http://localhost:8008
MARKETPLACE_API_URL=http://localhost:8085/registry/api/v1/plugins

# ============ Spring Boot Configuration ============

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_FSTICK=DEBUG

# ============ AWS S3 / MinIO Configuration ============

AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_BUCKET=plugins
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=11111111
AWS_S3_FORCE_PATH_STYLE=true

# ============ Docker Network ============

DOCKER_NETWORK=fstick-network

# ============ Volumes ============

# Database Volumes
REGISTRY_DB_VOLUME=registry-db-data
INSTALLATION_DB_VOLUME=installation-db-data
INTEGRATION_DB_VOLUME=integration-db-data
RUNTIME_DB_VOLUME=runtime-db-data
GATEWAY_DB_VOLUME=gateway-db-data
DENDRITE_DB_VOLUME=dendrite-postgres-data

# Cache Volumes
INSTALLATION_REDIS_VOLUME=installation-redis-data
INTEGRATION_REDIS_VOLUME=integration-redis-data
RUNTIME_REDIS_VOLUME=runtime-redis-data

# Storage Volumes
MINIO_VOLUME=minio-data

# Dendrite Volumes
DENDRITE_MEDIA_VOLUME=dendrite-media
DENDRITE_JETSTREAM_VOLUME=dendrite-jetstream
DENDRITE_SEARCH_INDEX_VOLUME=dendrite-search-index

# ============ Development Settings ============

# Set to "true" for development, "false" for production
DEVELOPMENT_MODE=true

# Enable debug logging
DEBUG=false

# Enable health checks
ENABLE_HEALTH_CHECKS=true

# ============ Feature Flags ============

ENABLE_REGISTRY=true
ENABLE_INSTALLATION=true
ENABLE_INTEGRATION=true
ENABLE_RUNTIME=true
ENABLE_GATEWAY=true

# ============ Marketplace Configuration ============

MARKETPLACE_ENABLED=true
MARKETPLACE_API_ENDPOINT=http://localhost:8085/registry/api/v1/plugins
MARKETPLACE_MAX_FILE_SIZE=104857600  # 100MB in bytes

# ============ Dendrite Configuration ============

DENDRITE_VERSION=latest
DENDRITE_ENABLE_OPEN_REGISTRATION=true
DENDRITE_TRUSTED_ID_SERVERS=["vector.im"]

# ============ Notes ============
# - Modify passwords for production use
# - Use environment-specific files (development.env, production.env)
# - Keep sensitive data in secure vaults
# - Update service URLs if deployment topology changes

